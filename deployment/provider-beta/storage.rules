rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.superadmin == true ||
        request.auth.token.role == "admin"
      );
    }

    function isAllowedProviderImage() {
      return request.resource != null &&
        request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType.matches(
          '^image/(jpeg|png|webp|gif|avif)$'
        );
    }

    match /iconos/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /iconos_archived/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /decoraciones/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /proveedores/{allPaths=**} {
      // Private beta: no SDK access, including imported and new media.
      allow read, write: if false;
    }

    match /borradores/{allPaths=**} {
      allow read, write: if false;
    }

    // Compatibility fallback for existing app assets.
    match /{topLevel}/{allPaths=**} {
      allow read: if isSignedIn() &&
        topLevel != "proveedores" &&
        topLevel != "borradores";
      allow write: if isSignedIn() &&
        topLevel != "proveedores" &&
        topLevel != "borradores";
    }
  }
}
