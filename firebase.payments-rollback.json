{
  "functions": [
    {
      "source": "functions-payments",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        ".env*",
        ".secret*",
        ".runtimeconfig.json"
      ],
      "predeploy": [
        "node functions/scripts/checkDeployReadiness.cjs payments",
        "npm --prefix functions run build:payments"
      ]
    }
  ]
}
