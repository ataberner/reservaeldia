{
  "name": "functions",
  "scripts": {
    "lint": "node scripts/lint.cjs",
    "contracts:sync": "node scripts/syncTemplateContract.cjs",
    "contracts:check": "node scripts/syncTemplateContract.cjs --check --input",
    "contracts:check:built": "node scripts/syncTemplateContract.cjs --check",
    "test:contracts": "node --test --test-reporter=tap scripts/contracts.test.cjs",
    "test:emails": "node --test transactionalEmail.test.mjs sesDiagnostics.test.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "node scripts/buildContracts.cjs",
    "build:watch": "node scripts/buildContracts.cjs --watch",
    "serve": "node ../scripts/local/runLocal.cjs emulators",
    "shell": "node ../scripts/local/runLocal.cjs emulators",
    "start": "node ../scripts/local/runLocal.cjs emulators",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "dev": "node ../scripts/local/runLocal.cjs emulators"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1120.0",
    "@sparticuz/chromium": "^147.0.0",
    "express": "^5.1.0",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0",
    "jsdom": "^26.1.0",
    "mercadopago": "^2.12.0",
    "openai": "^7.5.0",
    "puppeteer-core": "^24.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.3",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/react": "19.1.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
